.claude/

# ML training data - can grow to hundreds of MB
/data/
/raw/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.env

# Local dependency/debug downloads
tmp_media3_*/
tmp_media3_*.zip

# Local generated Edge Impulse SDK exports. Keep wrappers in git, not SDK drops.
/apps/collector/android/app/src/main/cpp/edge_impulse_local/
/apps/collector/android/app/src/main/jniLibs/**/libedge_impulse_pingpong.so

# Model artifacts (keep .tflite in git, exclude large checkpoints)
*.pkl
*.h5
*.ckpt
!data/models/*.tflite
